[Unit]
Description=Create and verify Oveo encrypted local backup
RequiresMountsFor=/var/lib/oveo /var/backups/oveo
After=docker.service
# A failed or incomplete backup leaves a record and a critical journal entry.
OnFailure=oveo-backup-failure.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/oveo-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/oveo /usr/local/lib/oveo
# SQLite's online backup needs a transient WAL/SHM lock even though it does not mutate rows.
ReadWritePaths=/var/lib/oveo /var/backups/oveo /run/lock
