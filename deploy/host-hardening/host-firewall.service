[Unit]
Description=Host input firewall
Documentation=man:nft(8)
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/nft delete table inet host_firewall
ExecStart=/usr/sbin/nft -f /etc/host-firewall.nft
ExecReload=/usr/sbin/nft delete table inet host_firewall
ExecReload=/usr/sbin/nft -f /etc/host-firewall.nft
ExecStop=-/usr/sbin/nft delete table inet host_firewall

[Install]
WantedBy=sysinit.target
