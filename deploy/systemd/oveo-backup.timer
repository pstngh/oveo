[Unit]
Description=Run the Oveo encrypted backup after each workday

[Timer]
# Oveo is used on workdays only: the Tuesday to Saturday runs cover Monday to Friday.
OnCalendar=Tue..Sat *-*-* 03:15:00 UTC
Persistent=true
RandomizedDelaySec=10m
Unit=oveo-backup.service

[Install]
WantedBy=timers.target

